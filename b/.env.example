# DeepSeek OpenAI-compatible API
DEEPSEEK_API_KEY=sk-your-key
DEEPSEEK_BASE_URL=https://api.deepseek.com
# 模型名，可按控制台实际可用模型调整
DEEPSEEK_MODEL=deepseek-chat
# 无密钥时设为 true 可走规则演示流程（计划/评估为占位逻辑）
CO_REDTEAM_MOCK_LLM=false

# Docker 沙箱配置
# 是否启用 Docker 隔离执行（推荐 true）
CO_REDTEAM_DOCKER_ENABLED=true
# 沙箱镜像名称（首次运行前需构建：docker build -t co-redteam-sandbox:latest .）
CO_REDTEAM_DOCKER_IMAGE=co-redteam-sandbox:latest
# 容器执行超时时间（秒）
CO_REDTEAM_DOCKER_TIMEOUT=30
# 容器内存限制
CO_REDTEAM_DOCKER_MEMORY=256m
# 容器 CPU 配额（微秒，50000 = 50% 单核）
CO_REDTEAM_DOCKER_CPU_QUOTA=50000
