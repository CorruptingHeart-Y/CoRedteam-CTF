# ============================================================
# LLM Provider (OpenAI-compatible API)
# ============================================================
# 支持任何 OpenAI 兼容接口：DeepSeek、GLM、vLLM、Ollama、中转站等
DEEPSEEK_API_KEY=sk-your-key
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# 使用中转站示例（如 blsc）：
# DEEPSEEK_BASE_URL=https://llmapi.blsc.cn/v1
# DEEPSEEK_MODEL=deepseek-chat

# JSON strict mode（默认开启）
# 中转站如果不支持 response_format，设置为 false
CO_REDTEAM_JSON_MODE=true

# Mock 模式（无需 API Key）
CO_REDTEAM_MOCK_LLM=false

# Docker 沙箱配置
# 是否启用 Docker 隔离执行（推荐 true）
CO_REDTEAM_DOCKER_ENABLED=true
# 沙箱镜像名称（首次运行前需构建：docker build -t co-redteam-sandbox:latest .）
CO_REDTEAM_DOCKER_IMAGE=co-redteam-sandbox:latest
# 容器执行超时时间（秒）
CO_REDTEAM_DOCKER_TIMEOUT=30
# 容器内存限制
CO_REDTEAM_DOCKER_MEMORY=256m
# 容器 CPU 配额（微秒，50000 = 50% 单核）
CO_REDTEAM_DOCKER_CPU_QUOTA=50000

# ──────────────────────────────────────────────
# 全局复盘智能体 (Global Consolidator) 配置
# 独立高级大模型，用于迭代结束后提炼战略级经验
# 如果不配置，每次迭代结束后自动跳过全局复盘
# ──────────────────────────────────────────────
CONSOLIDATOR_API_KEY=sk-your-key
CONSOLIDATOR_BASE_URL=https://api.deepseek.com
CONSOLIDATOR_MODEL=deepseek-chat